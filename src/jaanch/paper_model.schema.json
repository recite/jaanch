{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The paper model: what a paper claims, how, and from what data. Written once by jaanch_map_paper; every check reads it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "field", "question", "summary", "sections", "claims", "designs", "data_sources", "numbers", "tables", "figures", "references"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "field": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1, "description": "the research question in one sentence"},
    "summary": {"type": "string", "minLength": 1, "description": "question, method and main answer in three sentences"},
    "sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/section"}},
    "claims": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/claim"}},
    "designs": {"type": "array", "items": {"$ref": "#/$defs/design"}},
    "data_sources": {"type": "array", "items": {"$ref": "#/$defs/data_source"}},
    "sample_flow": {"type": "array", "items": {"$ref": "#/$defs/sample_step"}},
    "numbers": {"type": "array", "items": {"$ref": "#/$defs/number"}},
    "tables": {"type": "array", "items": {"$ref": "#/$defs/exhibit"}},
    "figures": {"type": "array", "items": {"$ref": "#/$defs/exhibit"}},
    "references": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "provenance": {"type": "array", "items": {"$ref": "#/$defs/provenance"}, "description": "only when code is present: which script makes each exhibit"},
    "registration": {"type": ["string", "null"], "description": "registry id or document, if any"}
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "heading", "start_line", "end_line"],
      "properties": {
        "id": {"type": "string", "pattern": "^s[0-9]{2}$"},
        "heading": {"type": "string"},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "words": {"type": "integer"},
        "has_math": {"type": "boolean"},
        "has_tables": {"type": "boolean"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim", "quote", "location", "type", "estimand", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^c[0-9]+$"},
        "claim": {"type": "string", "minLength": 1},
        "quote": {"type": "string", "minLength": 8},
        "location": {"type": "string"},
        "type": {"enum": ["descriptive", "predictive", "causal"]},
        "mechanism": {"type": ["string", "null"], "description": "the mechanism the paper asserts for this claim, if any"},
        "extrapolation": {"type": ["string", "null"], "description": "a population, period or setting the claim reaches beyond the sample, if any"},
        "estimand": {"$ref": "#/$defs/estimand"},
        "magnitude": {"$ref": "#/$defs/magnitude"},
        "unit_substitution": {"type": ["string", "null"], "description": "when the claim's unit differs from the measured one, e.g. 'measured emails, claims politicians'"},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "exhibit ids or section ids, e.g. 'Table 2, col 3'"}
      }
    },
    "estimand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "unit", "population", "outcome", "comparison"],
      "properties": {
        "statement": {"type": "string", "description": "the estimand in one sentence"},
        "unit": {"$ref": "#/$defs/stated"},
        "population": {"$ref": "#/$defs/stated"},
        "treatment_or_exposure": {"$ref": "#/$defs/stated"},
        "outcome": {"$ref": "#/$defs/stated"},
        "comparison": {"$ref": "#/$defs/stated"},
        "aggregation": {"$ref": "#/$defs/stated"},
        "weighting": {"$ref": "#/$defs/stated"},
        "period": {"$ref": "#/$defs/stated"},
        "decision_maker": {"$ref": "#/$defs/stated"},
        "behavioral_stage": {"$ref": "#/$defs/stated"}
      }
    },
    "stated": {
      "description": "what the paper says, or the literal string 'not stated' (itself a finding for required elements)",
      "type": "string",
      "minLength": 1
    },
    "magnitude": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "raw": {"type": "string", "description": "value with its unit, e.g. '4.1 percentage points'"},
        "relative_or_standardized": {"type": "string"},
        "uncertainty": {"type": "string", "description": "SE, CI or p as reported"},
        "baseline": {"type": "string", "description": "the comparison-group level, e.g. 'control mean 21.6%'"}
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design", "role", "reason", "quote"],
      "properties": {
        "design": {
          "type": "string",
          "pattern": "^(descriptive|experiment|did|rd|iv|panel|matching|synth|measurement|survey|text|structural|ml|meta|proof|other:[a-z_]+)$"
        },
        "role": {"enum": ["main", "robustness", "side"]},
        "claims": {"type": "array", "items": {"type": "string", "pattern": "^c[0-9]+$"}},
        "reason": {"type": "string", "minLength": 1},
        "quote": {"type": "string", "minLength": 8}
      }
    },
    "data_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "quote"],
      "properties": {
        "name": {"type": "string"},
        "kind": {"enum": ["survey", "experiment", "administrative", "observational", "text", "scraped", "simulated", "secondary", "other"]},
        "provenance": {"type": "string", "description": "who collected it, when, and how the paper got it"},
        "unit": {"type": "string"},
        "n": {"type": "string"},
        "period": {"type": "string"},
        "files": {"type": "array", "items": {"type": "string"}, "description": "inventory.json data files that hold it, if present"},
        "quote": {"type": "string", "minLength": 8}
      }
    },
    "sample_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "n"],
      "properties": {"step": {"type": "string"}, "n": {"type": "string"}, "quote": {"type": "string"}}
    },
    "number": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "quote", "location"],
      "properties": {
        "value": {"type": "string"},
        "quote": {"type": "string", "minLength": 1},
        "location": {"type": "string"},
        "refers_to": {"type": "string"}
      }
    },
    "exhibit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "caption"],
      "properties": {
        "id": {"type": "string"},
        "caption": {"type": "string"},
        "start_line": {"type": "integer"},
        "end_line": {"type": "integer"},
        "line": {"type": "integer"},
        "text_available": {"type": "boolean"},
        "file": {"type": "string"}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "text"],
      "properties": {"key": {"type": "string"}, "text": {"type": "string"}}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exhibit", "script"],
      "properties": {
        "exhibit": {"type": "string"},
        "script": {"type": "string"},
        "output": {"type": "string"},
        "data": {"type": "array", "items": {"type": "string"}},
        "manual": {"type": "boolean", "description": "true when the exhibit is typed rather than generated"}
      }
    }
  }
}
